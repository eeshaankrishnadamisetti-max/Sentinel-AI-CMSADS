### ⚙️ `config.py`
```python
"""
Configuration file for Sentinel-AI PoC
All settings used in the simulation are defined here.
"""

MODEL_PATH = "drone_detector_assets.joblib"

# Simulated sensor pins (only symbolic for non-Raspberry Pi systems)
OPTICAL_PIN = 17
IR_PIN = 27

# Loop control
DETECTION_INTERVAL_SEC = 1

# MQTT placeholder (for demonstration)
MQTT_TOPIC = "sentinel/poc/alerts"
BROKER_ADDRESS = "localhost"
PORT = 1883

# Simulation
ENABLE_RF_SIMULATION = True
ENABLE_VIDEO_SIMULATION = True
LOG_FILE = "data/sentinel_log.txt"
